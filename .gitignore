# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
.eggs/
.venv/
venv/

# Environment
.env
.env.local

# IDE
.idea/

# 本地 AI 工具的个人配置（模型/密钥等，不入库）
.codebuddy/models.json
# .claude/mcp.json 可能含明文 API Key，且不是任何工具的读取路径（生效的是
# <项目根>/.mcp.json 与 ~/.codebuddy/.mcp.json），一律不入库
.claude/mcp.json

# Generated indices (auto-regeneratable)
.coverage
.superpowers/
.superprojects/

# understand-anything：图谱/指纹为本地生成物，整目录不入库（2026-09-24 决定，
# 偏离官方"提交 .ua/"的建议 —— 目的是让每次 commit 不再附带全图更新）
# ⚠ .ua/.understandignore 是"装载性"配置：增量更新只读本文件而不读 CLI --exclude，
#   缺了它首次自动更新会因文件集暴涨（419 → 1054）升级为 FULL_UPDATE 重建全图。
.ua/

# Docker volume data
/data/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Playwright CLI artifacts
.playwright-cli/

# Firecrawl CLI artifacts（多 URL 抓取时会落盘）
.firecrawl/
