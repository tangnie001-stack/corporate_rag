# 环境变量清单（仅键名，不含任何真值）
# 复制为 .env 后填入真实值。以下键为必填，缺失会导致启动或 compose 校验失败：
#   POSTGRES_PASSWORD   —— 应用库账号密码；compose 里用 ${POSTGRES_PASSWORD:?} 强制要求
#   REDIS_PASSWORD
#   DASHSCOPE_API_KEY
#   LANGFUSE_POSTGRES_PASS
#   LANGFUSE_INIT_PROJECT_ID / _PUBLIC_KEY / _SECRET_KEY
#                       —— Langfuse 空库首次启动的播种开关；缺 _ID 则 project 与 key 都不建，
#                          且不报错（UI 无可用凭据）。_PUBLIC_KEY / _SECRET_KEY 须与
#                          LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY 是同一对
#   LANGFUSE_INIT_USER_EMAIL / _PASSWORD
#                       —— 管理员账号；缺任一则不建用户，UI 无法登录

AUTH_TOKEN_TTL=
CHUNK_EVAL_ENABLED=
CHUNK_OVERLAP=
CHUNK_SIZE=
CLASSIFY_MODEL=
COMPOSE_PROFILES=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DEEPSEEK_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
FASTAPI_HOST=
FASTAPI_PORT=
LANGFUSE_ENABLE=true
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_HOST=
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_POSTGRES_PASS=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SALT=
LANGFUSE_SECRET_KEY=
LITELLM_MASTER_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=
MAX_FILE_SIZE=
MEMORY_WINDOW=
MINIO_ACCESS_KEY=
MINIO_DOC_BUCKET=
MINIO_ENDPOINT=
MINIO_SECRET_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PORT=
POSTGRES_USER=
RAGAS_LLM_MODEL=
